# LetXinet-Suite.env — Configuracion centralizada del Suite (variante B)
# ============================================================================
#
# Ubicacion copia de trabajo: %PROGRAMDATA%\LetXinet Suite\LetXinet-Suite.env
# Ubicacion template fuente : {app}\shared-env\LetXinet-Suite.env
#
# Resumen:
#   - Una KEY=VALUE por linea. Comentarios con #. Sin comillas.
#   - Editar como ADMIN: atajo Menu Inicio "Editar LetXinet-Suite.env" (UAC).
#   - Las variables AQUI sobreescriben las del .env interno del V11
#     ({app}\MCP-V11-Local\.env) en runtime.
#   - Se PRESERVA al reinstalar el Suite (no se toca si ya existe).
#   - Cualquier cambio requiere restart del servicio afectado:
#       nssm restart LetXinetSuiteOSMMCP
#       nssm restart LetXinetSuiteMarkitDown
#       nssm restart LetXinetSuiteMCPV11
#     (o services.msc -> boton derecho -> Restart)
#
# Variante B (publica) -- incluida por defecto: sustituir los placeholders
#                          vacios por tus propias claves en las secciones de
#                          IA / SERP / academic APIs.
#
# ============================================================================


# ============================================================================
# [1] Puertos locales (NO TOUCH salvo conflicto KO)
# ============================================================================

# OSM-MCP HTTP+SSE (servicio NSSM)
OSM_MCP_PORT=7082
# OSM-MCP monitoring/Prometheus
OSM_METRICS_PORT=9090
# MCP-V11 HTTP+SSE (servicio NSSM)
MCP_V11_PORT=4003
# MCP-V11 sidecar spaCy Flask (interno, no exponer)
SPACY_PORT=4002
# MarkItDown FastAPI (servicio NSSM)
MARKITDOWN_API_PORT=7860
# Electron Desktop HF - Express interno
DESKTOP_PORT=43123
# Alias alternativo por compat del main.cjs
LETXIPU_DESKTOP_PORT=43123

# Loopback V11 interno (lo que el Desktop HF invoca via gateway mode)
LOCAL_MCP_URL=http://127.0.0.1:4003/api/mcp
LOCAL_MCP_PORT=4003


# ============================================================================
# [2] Modo de endpoints del Desktop HF
# ============================================================================
# auto        = local MCP-V11 primero, fallback a remote HF (default)
# local_only  = solo el MCP-V11 local instalado por este Suite
# remote_only = solo el remote HF/letxinet
# hf_only     = legacy: hard-coded HF spaces (back-compat con DESKTOP_HF_ONLY=1)
DESKTOP_ENDPOINT_MODE=local_only
# DESKTOP_HF_ONLY=true  # descomentar si DESKTOP_ENDPOINT_MODE=hf_only


# ============================================================================
# [3] Endpoints remotos (fallback HF Spaces publicos)
# ============================================================================
# Solo se usan cuando el local falla o cuando DESKTOP_ENDPOINT_MODE=remote_only/hf_only.
# Variante C v1.2: el operador rellena las URLs manualmente (no hardcodeadas).
LETXIPU_MCP_URL=https://C2MV-letxipu-search-mcp-v9.hf.space/api/mcp
LETXIPU_OSM_MCP_URL=https://c2mv-letxipu-osm-mcp.hf.space/mcp
LETXINET_MCP_URL=https://www.letxinet.lat/api/v1/mcp


# ============================================================================
# [4] OSM-MCP (OpenStreetMap)
# ============================================================================
# User-Agent para requests a Nominatim/Overpass/OSRM.
# Nominatim exige un contacto real; rellenar con email del operador:
OSM_USER_AGENT=LetXinet-Suite/1.1.6
# OSM_MCP_URL=http://127.0.0.1:7082  # override desde V11 hacia OSM (no necesario)
# Override de servicios OSM upstream (solo si tienes self-hosted):
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de


# ============================================================================
# [5] MCP-V11-Local: PDF resolver + Doc extraction
# ============================================================================

# LetXinet 1.1.3: Sci-Hub desactivado por riesgo legal. download_pdf usa solo fuentes abiertas
# (Unpaywall, CORE, PMC, Europe PMC y repositorios).
SCIHUB_MIRRORS=
# Endpoint base de Unpaywall (sin /v2/{doi})
UNPAYWALL_BASE_URL=https://api.unpaywall.org/v2
# Email de contacto - POLITICA UNPAYWALL: debe ser correo real del operador
UNPAYWALL_EMAIL=
# Endpoint base del DOI resolver
DOI_RESOLVER_URL=https://doi.org

# Modo de extraccion de documentos (auto | mineru_only | markitdown_only | pdfparse_only)
DOC_EXTRACTOR_MODE=auto
# Permitir extraccion remota a MinerU Cloud API
ALLOW_REMOTE_EXTRACTION=true
# MarkItDown local activado
MARKITDOWN_ENABLED=true
# Path al Python runtime portatil (relativo a {app}\MCP-V11-Local)
MARKITDOWN_PYTHON=python-runtime\python.exe
# Timeout y max de tamano para el extractor
EXTRACTOR_TIMEOUT_MS=300000
EXTRACTOR_MAX_MB=200
# Concurrency batch Max
MAX_BATCH_CONCURRENCY=4
# Provider timeouts (MinerU, etc.)
PROVIDER_TIMEOUT_MS=60000
PROVIDER_GATE_TTL_MS=1800000
# Renati (algunas fuentes espanolas)
RENATI_ATTEMPT_TIMEOUT_MS=30000

# URL MarkItDown local (interno, NSSM)
MARKITDOWN_API_URL=http://127.0.0.1:7860

# spaCy sidecar
SPACY_MODEL=es_core_news_sm
SPACY_CACHE_ROOT=python-runtime\Lib\site-packages
SPACY_SCRIPT=python\spacy_server.py
# SPACY_PYTHON=python-runtime\python.exe  # normalmente lo rellena el launcher

# LETXIPU_DESKTOP_GATEWAY=true  # se setea solo en start-mcp-v11-local.cmd


# ============================================================================
# [6] MinerU API (Document -> Markdown en la nube)
# ============================================================================
# Sin token    = Flash mode  (20 pages / 10MB por archivo, IP rate-limited)
# Con token    = Precision mode (200 pages / 200MB, 5000 pages/dia)
#
# Registro gratuito en https://mineru.net -> Login -> API Management
MINERU_API_KEY=
MINERU_API_URL=https://mineru.net/api/v4
MINERU_TIMEOUT=300000


# ============================================================================
# [7] Sources acdmicas - API keys (VARIANTE B: RELLENAR CON TUS CLAVES)
# ============================================================================
#
# Todos los servicios tienen tier gratuito acadmico/individual.
# Dejar vacio = la fuente devuelve 401 (no rompe el Suite, solo deshabilita esa fuente).

# CORE (https://core.ac.uk/services/api)
CORE_API_KEY=

# SCOPUS (Elsevier, requiere afiliacion institucional)
# https://dev.elsevier.com
SCOPUS_API_KEY=

# Semantic Scholar (https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=

# Google Scholar SERP API (https://serpapi.com)
# NOTA: la variable se llama SERP_API_KEY en server.ts y SERPAPI_KEY en main.cjs.
# Recomendado: dejar AMBAS rellenas con el mismo valor.
SERP_API_KEY=
SERPAPI_KEY=

# HuggingFace token (https://huggingface.co/settings/tokens)
# Necesario para modelos gated / espacios privados C2MV
HF_TOKEN=

# Redalyc (https://www.redalyc.org)
REDALYC_TOKEN=

# OpenAlex (https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication)
# 100k requests/dia sin auth; 100k+/dia con email. Sin API key.
OPENALEX_MAILTO=letxipu@search.mcp
OPENALEX_DAILY_CAP=100000

# OpenReview (https://docs.openreview.net)
# Cuenta gratuita para acceso academico:
# OPENREVIEW_USERNAME=usuario
# OPENREVIEW_PASSWORD=
# OPENREVIEW_API_V1=https://api.openreview.net
# OPENREVIEW_API_V2=https://api2.openreview.net


# ============================================================================
# [8] Modelos de IA (VARIANTE B: RELLENAR SOLO LOS QUE USES)
# ============================================================================
#
# Chat/LLM soportados por el Desktop HF (server.ts + main.cjs). Solo se usan
# si el renderer pide una feature que requiera LLM; el Suite no los invoca por
# defecto excepto si activas herramientas como paper-summarization.

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_TOKEN=
# Alias alternativo del launcher V11
ANTHROPIC_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_TOKEN=
OPENAI_API_KEY=

# Groq (https://console.groq.com/keys)
GROQ_TOKEN=
GROQ_API_KEY=

# Mistral (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# NVIDIA NIM (opcional, https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenCode Cloud (opcional, si Operador usa opencode.ai backend)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://api.opencode.ai/v1


# ============================================================================
# [9] Logging / telemetria
# ============================================================================
# Nivel: trace | debug | info | warn | error
LOG_LEVEL=info
# LETXIPU_LOG_LEVEL=info
# LETXIPU_PRETTY=false
# LETXIPU_METRICS=false
# LOG_PATH=  # default: pino a stdout (que NSSM redirige a Logs\mcp-v11-local.stdout.log)
# RAW_LOG=false
# NODE_TLS_REJECT_UNAUTHORIZED=0  # solo para debug TLS con proxies self-signed

# Carpeta centralizada de logs (NSSM AppStdout/AppStderr apuntan aqui tambien)
# SUITE_LOG_DIR=%PROGRAMDATA%\LetXinet Suite\Logs


# ============================================================================
# [10] MarkItDown API - opciones avanzadas (raramente necesario tocar)
# ============================================================================
# Tamano maximo de PDF/DOCX en MB. Default 200.
# MARKITDOWN_MAX_PDF_MB=200

# Path override del Python runtime (por defecto se usa el bundled del Suite)
# MARKITDOWN_PYTHON={app}\MarkItDown\API\python-runtime\python.exe


# ============================================================================
# [11] Electron Desktop HF - paths y opciones
# ============================================================================
# v1.1.0 Dual Build: layout cambio de app.asar.unpacked/ a app/ directo
# porque asar:false en electron-builder config. main.cjs detecta ambos paths.
# LETXIPU_DESKTOP_STATIC_DIR  (normalmente lo rellena el main.cjs a resources\app)
# LETXIPU_DESKTOP_USERDATA    (default: %APPDATA%\LetXipu Desktop HF)
# LETXIPU_LOCAL_MCP_DIR       (default: {app}\MCP-V11-Local)


# ============================================================================
# [12] v1.1.0 Dual Build integracion (Sesion 5, 6-Ago-2026)
# ============================================================================
# BUILD_VARIANT define el comportamiento del Desktop HF en runtime.
# VariantA (interno): BUILD_VARIANT=private
#   - URLs HF fallback activas (https://C2MV-letxipu-search-mcp-v9.hf.space/...)
#   - DESKTOP_ENDPOINT_MODE default "auto" (local primero, fallback remoto)
#   - resources/secrets.json embebido en el instalador con 3 IA provider keys
#   - main.cjs seedSecretsFromBundle() copia secrets.json a userData en primer arranque
#
# VariantB (publico): BUILD_VARIANT=public
#   - NO URLs HF fallback (empty string default)
#   - DESKTOP_ENDPOINT_MODE default "local_only" (solo servicios locales)
#   - NO resources/secrets.json en el bundle (operador rellena via GUI)
#   - main.cjs seedSecretsFromBundle() no hace seed (archivo ausente)
#
# Default si no se define: "private" (back-compat con v1.0.1)
BUILD_VARIANT=public

# Las 3 IA provider keys que el Desktop HF usa para paper-summarization y chat IA.
# Estas keys viven en %APPDATA%\LetXipu Desktop HF\secrets.json (no en .env).
# VariantA: se pre-pueblan via seedSecretsFromBundle() desde resources/secrets.json embebido.
# VariantB: el operador las configura en ProvidersSyncPanel GUI (tab "API Keys").
# - Nebius AI Cloud: https://studio.nebius.com
# - OpenRouter: https://openrouter.ai/keys
# - DeepSeek: https://platform.deepseek.com/api-keys
NEBIUS_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=


# ============================================================================
# FIN
# Verificacion: tras editar, ejecuta como admin:
#   nssm restart LetXinetSuiteOSMMCP
#   nssm restart LetXinetSuiteMarkitDown
#   nssm restart LetXinetSuiteMCPV11
# ============================================================================

# Ajustes incorporados desde la instalación con parches (02/11/2026)
SPACY_DISABLE=1
OAI_MAXPAGES=10
