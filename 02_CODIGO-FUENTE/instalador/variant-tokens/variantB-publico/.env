# LetXipu Search MCP v7 - Environment Variables (VARIANT B - PUBLICO)
# ============================================================
# Esta variante NO incluye tokens de servicios de pago. Los usuarios
# finales pueden agregar sus propios tokens aqui.
#
# v1.1.0 (Sesion 5 Dual Build integracion):
#   BUILD_VARIANT=public hace que server.cjs NO active URLs HF fallback
#   (modo local_only por defecto) y NO se espere resources/secrets.json.
#   El usuario configura las 3 IA provider keys via ProvidersSyncPanel GUI.
# ============================================================

PORT=4003

# v1.1.0 build variant (public = no HF fallbacks, no secrets.json embebido)
BUILD_VARIANT=public

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MinerU API (Document -> Markdown)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Sin token = Flash mode (20 pages/10MB, IP rate-limited)
# Con token = Precision mode (200 pages/200MB, 5000 pages/dia)
# Registrese en https://mineru.net -> Login -> API Management
MINERU_API_KEY=
MINERU_API_URL=https://mineru.net/api/v4

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Document Extraction Router
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DOC_EXTRACTOR_MODE=auto
ALLOW_REMOTE_EXTRACTION=true
MARKITDOWN_ENABLED=true
# Path al Python runtime portatil del Suite (rellenado por launcher)
MARKITDOWN_PYTHON=python-runtime\python.exe
EXTRACTOR_TIMEOUT_MS=300000
EXTRACTOR_MAX_MB=200

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Academic API Keys
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Registrese en cada servicio para obtener su propia clave gratuita/acadmica.
CORE_API_KEY=
SCOPUS_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
SERP_API_KEY=
HF_TOKEN=
REDALYC_TOKEN=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Tokens IA generales (Variante A incluye estos)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# spaCy sidecar
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SPACY_PORT=4002
SPACY_MODEL=es_core_news_sm
SPACY_CACHE_ROOT=python-runtime\Lib\site-packages

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MarkItDown API URL (introservice)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MARKITDOWN_API_URL=http://127.0.0.1:7860
