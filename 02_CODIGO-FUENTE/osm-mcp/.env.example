# =============================================================================
# letxipu-osm-mcp environment variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# For HuggingFace Space Secrets, set these as Space Secrets (not Variables)
# at: https://huggingface.co/spaces/C2MV/letxipu-osm-mcp/settings
# =============================================================================

# --- Routing / OSRM -----------------------------------------------------------
# Per-profile OSRM server URLs. When empty, falls back to the public OSRM demo
# (router.project-osrm.org) which ONLY has a car graph — foot/bike silently
# get car results. For correct foot/bike times, point these at a self-hosted
# multi-profile OSRM instance, e.g.:
#   docker run -p 5000:5000 -v $(pwd)/osm-car:/data osrm/osrm-backend osrm-routed --algorithm mld /data/car.lua
#   docker run -p 5001:5000 -v $(pwd)/osm-foot:/data osrm/osrm-backend osrm-routed --algorithm mld /data/foot.lua
#   docker run -p 5002:5000 -v $(pwd)/osm-bike:/data osrm/osrm-backend osrm-routed --algorithm mld /data/bike.lua
# Trailing slashes are trimmed automatically.
OSRM_URL_CAR=https://router.project-osrm.org
OSRM_URL_BIKE=
OSRM_URL_FOOT=

# --- Overpass -----------------------------------------------------------------
# Override the Overpass API endpoint. Empty = public default (overpass-api.de).
# Useful if you run a private Overpass mirror for higher rate limits or lower
# latency in your region. Trailing slashes are trimmed automatically.
OVERPASS_URL=

# --- Nominatim ----------------------------------------------------------------
# Override the Nominatim geocoding endpoint. Empty = public default
# (nominatim.openstreetmap.org). Useful for self-hosted mirrors or a regional
# cache. Trailing slashes are trimmed automatically.
NOMINATIM_URL=

# Default region bias for geocoding (ISO 3166-1 alpha-2 country code).
# Example: "US" biases results toward the United States.
OSMMCP_DEFAULT_REGION=

# --- Tile server --------------------------------------------------------------
# Override the map tile server URL template (Slippy Map {z}/{x}/{y} convention).
# Empty = public OSM CDN (tile.openstreetmap.org). Useful for self-hosted tiles
# or a commercial provider (e.g. MapTiles, Stadia Maps). The URL MUST contain
# the {z}/{x}/{y} placeholders. Trailing slashes are NOT trimmed (the template
# is used as-is).
# Example: TILE_SERVER_URL=https://tiles.example.com/{z}/{x}/{y}.png
TILE_SERVER_URL=

# --- Tracing ------------------------------------------------------------------
# OpenTelemetry OTLP endpoint. If empty, tracing is disabled.
# Example: "http://localhost:4318"
OTLP_ENDPOINT=

# --- Environment --------------------------------------------------------------
# Deployment environment label (e.g. "production", "staging", "development").
# Used in traces and logs. Empty = no label.
ENVIRONMENT=production

# --- Server -------------------------------------------------------------------
# HTTP listen port. HF Space expects 7860.
PORT=7860
