{
  "name": "letxipu-search-mcp-v11-local",
  "version": "11.0.0-local",
  "description": "MCP V11 Local - backend MCP de busqueda academica portable (LetXipu Desktop HF)",
  "private": true,
  "bin": "dist/server.js",
  "pkg": {
    "scripts": [],
    "assets": [
      "src/config/**/*.json",
      "src/data/**/*.json"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "packaging/bin"
  },
  "scripts": {
    "dev": "npx ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:document-url": "npm run build && node scripts/test-document-url.js",
    "pkg": "npx yao-pkg . --targets node18-win-x64 --output packaging/bin/MCP-V11-Local.exe",
    "package": "node packaging/build-portable.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdf-parse": "^1.1.1",
    "pino": "^8.14.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.12",
    "@yao-pkg/pkg": "^6.21.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
