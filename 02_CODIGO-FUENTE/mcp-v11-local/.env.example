# LetXipu Search MCP v7.1 - Environment Variables
# NOTE: All variables can also be set in claude_desktop_config.json
#       under the "env" section. This .env file is only for local development.

PORT=4000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MinerU API (Document -> Markdown)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Get your FREE token at https://mineru.net -> Login -> API Management
# Without token = Flash mode (20 pages / 10MB per file, IP rate-limited)
# With token = Precision mode (200 pages / 200MB, 5000 pages/day)
# MINERU_API_KEY=your_token_here
# MINERU_API_URL=https://mineru.net/api/v4

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Document Extraction Router
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Mode: auto | mineru_first | markitdown_first | local_only | remote_only
#   auto             = decides based on doc type + engine availability
#   mineru_first     = MinerU -> MarkItDown -> pdf-parse
#   markitdown_first = MarkItDown -> MinerU -> pdf-parse
#   local_only       = MarkItDown -> pdf-parse (never sends to cloud)
#   remote_only      = MinerU -> pdf-parse
DOC_EXTRACTOR_MODE=auto

# Allow sending documents to MinerU cloud API for extraction
ALLOW_REMOTE_EXTRACTION=true

# MarkItDown (local Python/pymupdf4llm) settings
MARKITDOWN_ENABLED=true
MARKITDOWN_PYTHON=python

# Extraction limits
EXTRACTOR_TIMEOUT_MS=300000
EXTRACTOR_MAX_MB=200

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Academic API Keys (optional, all sources work without keys)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CORE_API_KEY=
# SCOPUS_API_KEY=
# S2_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OSM MCP Geocoder (V10 - Dynamic Geographic Detection)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# letxipu-osm-mcp sidecar for dynamic city/country detection via Nominatim.
# Replaces hardcoded CITY_TO_COUNTRY dictionary with live geocoding.
# Start with: docker run -d --name letxipu-osm -p 7860:7860 letxipu-osm-mcp
OSM_MCP_URL=http://localhost:7860
